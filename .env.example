# API & Database Configuration
# In Docker, use the mount path. Locally, the path might differ.
SPRING_DATASOURCE_URL=jdbc:sqlite:database/maplewood_school.sqlite?journal_mode=WAL&busy_timeout=5000
REACT_APP_API_URL=http://localhost:8080

# Student Credentials (Defaults for local development)
STUDENT_USERNAME=student
STUDENT_PASSWORD=password

# Admin Credentials (Defaults for local development)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
